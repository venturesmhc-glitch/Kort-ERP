# Postgres (coincide con docker-compose.yml)
DATABASE_URL="postgresql://kort:kort@localhost:5435/kort_db?schema=public"

# Auth
JWT_SECRET="changeme-super-secret"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Seed (usuario Dev inicial, ver prisma/seed.ts)
SEED_ADMIN_EMAIL="dev@kort.local"
SEED_ADMIN_PASSWORD="Password123!"

# Storage de imagenes: sin estas variables se usa disco local (default para
# dev). Para produccion (Render) ver .env.production.example.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=article-images
