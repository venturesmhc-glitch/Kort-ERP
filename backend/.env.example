# Postgres (coincide con docker-compose.yml)
DATABASE_URL="postgresql://kort:kort@localhost:5435/kort_db?schema=public"

# Auth
JWT_SECRET="changeme-super-secret"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Seed (usuario Dev inicial, ver prisma/seed.ts)
SEED_ADMIN_EMAIL="dev@kort.local"
SEED_ADMIN_PASSWORD="Password123!"

# Storage de imagenes: sin estas variables se usa disco local (default para
# dev). Para produccion (Render) ver .env.production.example.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=article-images

# Mail transaccional (confirmacion de turno) via Resend (https://resend.com).
# Sin RESEND_API_KEY el mail no se envia, solo queda un log.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Mi Barberia <turnos@tudominio.com>"

# WhatsApp Business Cloud API (recordatorio de turno 6hs antes). Requiere una
# app de Meta for Developers + numero verificado + una plantilla de mensaje
# aprobada (el alta y la aprobacion de la plantilla son pasos manuales en
# Meta Business Manager, no hay forma de automatizarlos desde el codigo).
# El body de la plantilla debe tener 4 variables posicionales, en este orden:
# nombre del cliente, fecha/hora del turno, nombre del barbero, codigo de turno.
# Sin WHATSAPP_TOKEN el recordatorio no se envia, solo queda un log.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_REMINDER_TEMPLATE=recordatorio_turno
# WHATSAPP_TEMPLATE_LANG=es_AR
# WHATSAPP_DEFAULT_COUNTRY_CODE=54
