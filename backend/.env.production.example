# Variables de entorno para produccion (Render + Supabase).
# No se usa este archivo directamente: es referencia para cargar las mismas
# claves en el dashboard de Render (o en render.yaml, que ya las declara).

# Postgres de Supabase: Project Settings > Database > Connection string >
# "Direct connection" (puerto 5432). Render corre un proceso Node persistente,
# no serverless, asi que no hace falta el connection pooler (puerto 6543).
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Auth. Generar un secreto nuevo y distinto del de desarrollo, ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (render.yaml ya lo genera automaticamente con generateValue: true).
JWT_SECRET="<generar-uno-nuevo>"
JWT_EXPIRES_IN="8h"

# Render inyecta PORT automaticamente; no hace falta declararlo.

# Dominio(s) del frontend en Vercel, separados por coma (prod + previews).
CORS_ORIGIN="https://kort-erp.vercel.app,https://kort-erp-*.vercel.app"

# URL publica de este backend en Render (usada solo si se cae a
# LocalDiskStorageService; con Supabase Storage configurado abajo no se usa
# para imagenes, pero no esta de mas dejarla).
PUBLIC_URL="https://kort-backend.onrender.com"

# Usuario DEV inicial (se crea corriendo "npm run prisma:seed -w backend"
# una vez, desde la pestania Shell de Render).
SEED_ADMIN_EMAIL="admin@tudominio.com"
SEED_ADMIN_PASSWORD="<contrasenia-fuerte>"

# Supabase Storage: si estas tres estan seteadas, StorageService sube las
# imagenes de articulos ahi en vez de a disco local (necesario en Render,
# que borra el filesystem en cada deploy/restart).
# - SUPABASE_URL: Project Settings > API > Project URL
# - SUPABASE_SERVICE_ROLE_KEY: Project Settings > API > service_role secret
#   (NUNCA usar este valor en el frontend, solo en el backend)
# - Crear antes el bucket "article-images" en Storage y marcarlo como
#   publico (Storage > New bucket > Public bucket).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="article-images"
