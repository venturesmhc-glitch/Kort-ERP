generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DEV
  ENCARGADO
  BARBERO
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role
  dni       String?  @unique
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workSchedules WorkSchedule[]
  appointments  Appointment[]
  cuts          Cut[]
  sales         Sale[]
  workSessions  WorkSession[]

  @@map("users")
}

model Client {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  cuts         Cut[]
  sales        Sale[]

  @@index([createdAt])
  @@map("clients")
}

// Modulo Turnos: horario semanal de atencion por barbero. El lapso por turno
// (slotMinutes) es una configuracion global, ver AppointmentSettings.
model WorkSchedule {
  id        String    @id @default(uuid())
  barberoId String
  barbero   User      @relation(fields: [barberoId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([barberoId, dayOfWeek])
  @@map("work_schedules")
}

// Configuracion global del modulo Turnos. Fila unica (id fijo en 1).
model AppointmentSettings {
  id          Int      @id @default(1)
  slotMinutes Int      @default(30)
  updatedAt   DateTime @updatedAt

  @@map("appointment_settings")
}

model Appointment {
  id              String            @id @default(uuid())
  code            String            @unique
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id])
  barberoId       String
  barbero         User              @relation(fields: [barberoId], references: [id])
  tipoCorteId     String
  tipoCorte       ParameterItem     @relation(fields: [tipoCorteId], references: [id])
  scheduledAt     DateTime
  durationMinutes Int
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  cut Cut?

  @@unique([barberoId, scheduledAt])
  @@map("appointments")
}

// Modulo Registro de cortes. El precio es un snapshot copiado de
// ParameterItem.price al momento del corte, no una referencia (ver Cut.price).
model Cut {
  id            String        @id @default(uuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  barberoId     String
  barbero       User          @relation(fields: [barberoId], references: [id])
  tipoCorteId   String
  tipoCorte     ParameterItem @relation(fields: [tipoCorteId], references: [id])
  price         Int
  photoUrl      String?
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  cutAt         DateTime      @default(now())
  createdAt     DateTime      @default(now())

  treasuryEntry TreasuryEntry?

  @@index([cutAt])
  @@map("cuts")
}

// Modulo Parametrizados: modelo generico (categoria + items) para que se puedan
// sumar catalogos nuevos sin migracion. Ver skills.md #5.11 y #8.
model ParameterCategory {
  id          String          @id @default(uuid())
  key         String          @unique
  name        String
  description String?
  isSystem    Boolean         @default(false)
  order       Int             @default(0)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       ParameterItem[]

  @@map("parameter_categories")
}

model ParameterItem {
  id              String            @id @default(uuid())
  categoryId      String
  category        ParameterCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name            String
  description     String?
  active          Boolean           @default(true)
  order           Int               @default(0)
  metadata        Json?
  // Precio del tipo de corte (solo lo usan los items de la categoria
  // "tipos-corte"; el resto de los catalogos lo ignora). Ver modulo Cortes.
  price           Int?
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  appointments    Appointment[]
  cuts            Cut[]
  articles        Article[]
  treasuryEntries TreasuryEntry[]

  @@unique([categoryId, name])
  @@map("parameter_items")
}

enum StockMovementType {
  IN
  OUT
}

// Modulo Articulos y Stock: stock es un contador cacheado, actualizado en la
// misma transaccion que cada StockMovement (ver StockService).
model Article {
  id                String          @id @default(uuid())
  name              String
  description       String?
  tipoProductoId    String
  tipoProducto      ParameterItem   @relation(fields: [tipoProductoId], references: [id])
  price             Int
  imageUrl          String?
  stock             Int             @default(0)
  lowStockThreshold Int?
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  movements         StockMovement[]
  saleItems         SaleItem[]

  @@map("articles")
}

model StockMovement {
  id        String            @id @default(uuid())
  articleId String
  article   Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int
  reason    String?
  createdAt DateTime          @default(now())

  @@map("stock_movements")
}

enum SaleChannel {
  POS
  MERCH
}

// Modulo Ventas: venta tipo carrito (Sale + SaleItem) para poder reutilizar el
// mismo modelo desde el futuro checkout publico de merch (etapa 11), via
// channel. sellerId es opcional porque ese checkout no tiene usuario logueado;
// las ventas del panel (channel POS) siempre lo llevan. El precio de cada item
// es un snapshot (SaleItem.unitPrice), igual que Cut.price.
model Sale {
  id          String      @id @default(uuid())
  channel     SaleChannel @default(POS)
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id])
  sellerId    String?
  seller      User?       @relation(fields: [sellerId], references: [id])
  totalAmount Int
  createdAt   DateTime    @default(now())

  items         SaleItem[]
  treasuryEntry TreasuryEntry?

  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  articleId String
  article   Article @relation(fields: [articleId], references: [id])
  quantity  Int
  unitPrice Int
  subtotal  Int

  @@map("sale_items")
}

enum WorkSessionCloseReason {
  MANUAL
  TIMEOUT
}

// Modulo Jornadas laborales: registra cada sesion de trabajo (login/logout)
// de Barbero/Encargado. Como el JWT es stateless, esta tabla es la unica
// fuente de "quien trabajo y desde cuando". El cierre por inactividad (2 hs,
// ver skills.md #4) se resuelve de forma perezosa en WorkShiftsService en vez
// de con un job periodico: no hay proceso nuevo que correr, y toda consulta
// de horas trabajadas aplica la regla de 2hs en vez de confiar en logoutAt.
model WorkSession {
  id             String                  @id @default(uuid())
  userId         String
  user           User                    @relation(fields: [userId], references: [id])
  loginAt        DateTime                @default(now())
  logoutAt       DateTime?
  lastActivityAt DateTime                @default(now())
  closeReason    WorkSessionCloseReason?
  createdAt      DateTime                @default(now())

  @@index([userId, loginAt])
  @@map("work_sessions")
}

enum TreasuryEntryType {
  INCOME
  EXPENSE
}

enum TreasuryExpenseKind {
  FIXED
  VARIABLE
}

enum TreasuryEntrySource {
  MANUAL
  CUT
  SALE
}

// Modulo Tesoreria: ledger unico de costos e ingresos, en vez de tablas
// separadas, para que historico y graficos recorran una sola fuente.
// expenseKind solo aplica cuando type = EXPENSE (costo fijo/variable).
// source distingue carga manual de los ingresos automaticos generados por
// Cortes/Ventas (cutId/saleId), ver TreasuryService.
model TreasuryEntry {
  id              String               @id @default(uuid())
  type            TreasuryEntryType
  expenseKind     TreasuryExpenseKind?
  categoryId      String
  category        ParameterItem        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount          Int
  description     String?
  entryDate       DateTime
  source          TreasuryEntrySource  @default(MANUAL)
  cutId           String?              @unique
  cut             Cut?                 @relation(fields: [cutId], references: [id])
  saleId          String?              @unique
  sale            Sale?                @relation(fields: [saleId], references: [id])
  createdByUserId String?
  createdAt       DateTime             @default(now())

  @@map("treasury_entries")
}
